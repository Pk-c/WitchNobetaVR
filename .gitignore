# --- build output -------------------------------------------------------------
build/
dist/
bin/
obj/
*.pdb

# --- things fetched rather than authored --------------------------------------
# Third-party archives pulled on demand by tools\fetch_bepinex.ps1 and
# tools\fetch_openxr.ps1. They are inputs to a build, not source.
tools/cache/

# The OpenXR provider binaries staged for the release archive. Redistributable
# under the Unity Package Distribution License, and they travel in the release,
# but they are fetched rather than written here.
packaging/xr/

# --- never publishable --------------------------------------------------------
# Interop assemblies generated by BepInEx from the installed game. They describe
# the game's own types and are a derivative of its shipped binary, so they stay
# on the machine that generated them. Also matched wherever a stray copy lands.
interop/
BepInEx/

# --- working notes ------------------------------------------------------------
# Kept on the machine rather than in the repository. README.md stays tracked: it is
# the landing page and carries the install instructions, so a published repo needs
# it. Drop the exception below to exclude it too.
*.md
!README.md

# --- development artefacts ----------------------------------------------------
*.log
logs/

# Captures and notes taken while investigating a specific run. Useful locally,
# meaningless to anyone else, and often large.
captures/
scratch/

# --- editors and tooling ------------------------------------------------------
.vs/
.vscode/
.idea/
*.user
*.suo
*.userprefs
*.DotSettings.user

# --- operating system ---------------------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
